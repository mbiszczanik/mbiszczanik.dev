---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostList from '../components/PostList.astro';
import PersonSchema from '../components/schema/PersonSchema.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR_JOB_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <PersonSchema />
  </head>
  <body>
    <Header />
    <main>
      <div class="eyebrow">{AUTHOR_JOB_TITLE}</div>
      <h1>Marcin Biszczanik</h1>
      <p class="lede">Notes on the decisions behind Azure platform work.</p>
      <p>
        Landing zones, Azure Verified Modules, Bicep, IaC governance, and migrations:
        what I chose, what I rejected, and why. Read more <a href="/about/">about me</a>.
      </p>
      <section>
        <h2>Latest posts</h2>
        <PostList posts={posts} />
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .lede {
    font-size: 22px;
    line-height: 1.4;
    color: var(--ink);
  }
  h2 {
    border-top: 0;
    padding-top: 0;
    font-size: 13px;
    font-family: var(--mono);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--meta);
    margin: 3em 0 12px;
  }
</style>
