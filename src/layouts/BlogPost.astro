---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BlogPostingSchema from '../components/schema/BlogPostingSchema.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, author, pubDate, updatedDate, canonicalURL } = Astro.props;
const postURL = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonicalURL={canonicalURL}
      ogType="article"
    />
    <BlogPostingSchema
      title={title}
      description={description}
      author={author}
      pubDate={pubDate}
      updatedDate={updatedDate}
      url={postURL}
    />
  </head>
  <body>
    <Header />
    <main>
      <article class="prose">
        <header class="title">
          <div class="eyebrow">
            <a href="/blog/">Blog</a>
            <span class="sep" aria-hidden="true">·</span>
            <FormattedDate date={pubDate} />
            {
              updatedDate && (
                <>
                  <span class="sep" aria-hidden="true">·</span>
                  <span>
                    Updated <FormattedDate date={updatedDate} />
                  </span>
                </>
              )
            }
          </div>
          <h1>{title}</h1>
          <p class="lede">{description}</p>
        </header>
        <slot />
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .title {
    margin-bottom: 1.5em;
    padding-bottom: 1.5em;
    border-bottom: 1px solid var(--rule);
  }
  .sep {
    color: var(--rule);
  }
  .eyebrow a {
    color: inherit;
    border-bottom: 0;
  }
  .eyebrow a:hover {
    color: var(--accent);
  }
  .lede {
    font-size: 20px;
    line-height: 1.5;
    margin: 0;
  }
</style>
