---
interface Props {
  title: string;
  description: string;
  author: string;
  pubDate: Date;
  updatedDate?: Date;
  image: string;
  url: string;
}

const { title, description, author, pubDate, updatedDate, image, url } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: author,
    url: new URL('/about/', Astro.site).href,
  },
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  image: new URL(image, Astro.site).href,
  mainEntityOfPage: url,
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
