---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
	<nav aria-label="Main">
		<a class="wordmark" href="/">{SITE_TITLE}</a>
		<div class="links">
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<button type="button" class="theme-toggle" hidden>Dark</button>
		</div>
	</nav>
</header>
<script is:inline>
	// Switches between light and dark and remembers the choice. Hidden without JS,
	// where the page simply follows the system setting.
	(() => {
		const button = document.querySelector('.theme-toggle');
		const root = document.documentElement;
		const system = window.matchMedia('(prefers-color-scheme: dark)');
		const current = () => root.dataset.theme ?? (system.matches ? 'dark' : 'light');
		const render = () => {
			const next = current() === 'dark' ? 'light' : 'dark';
			button.textContent = next === 'dark' ? 'Dark' : 'Light';
			button.setAttribute('aria-label', `Switch to ${next} mode`);
		};
		button.addEventListener('click', () => {
			const theme = current() === 'dark' ? 'light' : 'dark';
			root.dataset.theme = theme;
			try {
				localStorage.setItem('theme', theme);
			} catch {}
			const color = theme === 'dark' ? '#0d1426' : '#dde6f2';
			document.querySelectorAll('meta[name="theme-color"]').forEach((m) => (m.content = color));
			render();
		});
		system.addEventListener('change', render);
		render();
		button.hidden = false;
	})();
</script>
<style>
	header {
		padding: 0 24px;
	}
	nav {
		max-width: calc(var(--column) - 48px);
		margin: 0 auto;
		padding: 20px 0 14px;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		border-bottom: 1px solid var(--rule);
	}
	.wordmark {
		font-weight: 600;
		font-size: 18px;
		letter-spacing: -0.015em;
		color: var(--ink);
		border-bottom: 0;
	}
	.links {
		display: flex;
		align-items: baseline;
		gap: 20px;
	}
	.theme-toggle {
		font: inherit;
		font-family: var(--mono);
		font-size: 13px;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		color: var(--meta);
		background: none;
		border: 0;
		border-left: 1px solid var(--rule);
		padding: 0 0 0 20px;
		cursor: pointer;
	}
	.theme-toggle:hover {
		color: var(--accent);
	}
	.theme-toggle[hidden] {
		display: none;
	}
	@media (max-width: 720px) {
		header {
			padding: 0 20px;
		}
		nav {
			padding: 16px 0 12px;
		}
	}
</style>
