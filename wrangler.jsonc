{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Worker names allow only lowercase letters, digits and dashes (no dots).
	"name": "mbiszczanik-dev",
	"compatibility_date": "2026-09-27",
	// Static site: serve the Astro build output as Workers static assets, no Worker script.
	"assets": {
		"directory": "./dist"
	},
	// Custom domain: Cloudflare creates the DNS record and certificate on deploy.
	"routes": [
		{ "pattern": "mbiszczanik.dev", "custom_domain": true }
	],
	// Production lives only on the custom domain; workers.dev serves PR previews only
	// (<preview-name>-mbiszczanik-dev.<subdomain>.workers.dev). Applied by `wrangler deploy` on main.
	"workers_dev": false,
	"preview_urls": true,
	// Required by `wrangler preview`, which Workers Builds runs for non-production branches.
	"previews": {}
}
